# Список серверов (JSON-массив).
#
# Обязательное поле: host
# Опциональные поля:
#   user               — SSH-пользователь (default: root)
#   password           — SSH-пароль (оставь пустым для аутентификации по ключу)
#   domain             — домен для TLS (опционально; без него — самоподписанный TLS)
#   stack_path         — путь к стеку на этом сервере (переопределяет глобальный STACK_PATH)
#   tls_mode           — certbot (default) | external
#   external_tls_cert  — путь на сервере к сертификату (для tls_mode=external)
#   external_tls_key   — путь на сервере к ключу (для tls_mode=external)
#
# Примеры:
#
# Один сервер с certbot:
# SERVERS=[{"host":"1.2.3.4","user":"root","domain":"vpn.example.com"}]
#
# Сервер с внешними сертификатами (например, от Caddy):
# SERVERS=[{"host":"1.2.3.4","user":"root","domain":"vpn.example.com","tls_mode":"external","external_tls_cert":"/data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/vpn.example.com/vpn.example.com.crt","external_tls_key":"/data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/vpn.example.com/vpn.example.com.key"}]
#
# Два сервера с разными режимами TLS:
# SERVERS=[{"host":"1.2.3.4","domain":"vpn1.example.com"},{"host":"5.6.7.8","domain":"vpn2.example.com","tls_mode":"external","external_tls_cert":"/path/to/cert.crt","external_tls_key":"/path/to/cert.key"}]

SERVERS=[{"host":"your-server-ip","user":"root","domain":"your-domain.com"}]

# Путь к стеку по умолчанию (создаётся автоматически).
# Можно переопределить на уровне конкретного сервера в SERVERS.
STACK_PATH=~/xray-server

# Email для Let's Encrypt — общий для всех серверов.
# Обязателен если у сервера задан domain и tls_mode=certbot (или не задан).
CERTBOT_EMAIL=your@email.com

# Hysteria2 (официальный сервер apernet/hysteria, отдельный контейнер)
HYSTERIA_ENABLED=true
HYSTERIA_PORT=443
# URL для masquerade (HTTP/3 маскировка при неудачной аутентификации)
HYSTERIA_MASQUERADE_URL=https://addons.mozilla.org/
